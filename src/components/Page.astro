---
import { getDict, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import About from './About.astro';
import Certificates from './Certificates.astro';
import Contact from './Contact.astro';
import Faq from './Faq.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Location from './Location.astro';
import Marquee from './Marquee.astro';
import MobileCtaBar from './MobileCtaBar.astro';
import Prices from './Prices.astro';
import Results from './Results.astro';
import Reviews from './Reviews.astro';
import Services from './Services.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

/** Brauzer skriptlari uchun matnlar (rasm alt zaxiralari, lightbox tugmalari) */
const clientStrings = {
  locale,
  alt: {
    hero: t.hero.portraitAlt,
    about: t.about.portraitAlt,
    certificates: t.certificates.altFallback,
    results: t.results.altFallback,
    reviews: t.reviews.altFallback,
    clinic: t.about.clinicAlt,
    promo: t.prices.promo.imageAlt,
  },
  lightbox: t.lightbox,
  results: { before: t.results.before, after: t.results.after },
};
const clientJson = JSON.stringify(clientStrings).replace(/</g, '\\u003c');
---

<Base locale={locale} jsonLd>
  <Header t={t} />
  <main id="main" tabindex="-1">
    <Hero t={t} />
    <Marquee t={t} />
    <About t={t} />
    <Certificates t={t} />
    <Services t={t} />
    <Results t={t} />
    <Prices t={t} />
    <Reviews t={t} />
    <Location t={t} />
    <Faq t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />
  <MobileCtaBar t={t} />

  <script type="application/json" id="client-strings" set:html={clientJson} />
  <script>
    import '../scripts/site';
  </script>
</Base>
