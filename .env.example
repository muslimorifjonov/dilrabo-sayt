# Supabase → Project Settings → API  (ma’lumotlar bazasi, admin kirishi)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 — admin yuklagan rasmlar shu yerga ketadi (README → «Cloudflare R2»)
# Bucket’ning ommaviy manzili (custom domen yoki r2.dev). Bo‘sh bo‘lsa — Supabase Storage ishlatiladi.
PUBLIC_R2_PUBLIC_URL=
# Faqat serverda (Netlify funksiyasi) — HECH QACHON PUBLIC_ prefiksi bilan yozmang
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Ixtiyoriy: EU yurisdiksiyasi bo‘lsa, masalan https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Ixtiyoriy: saytning to‘liq manzili (bo‘sh bo‘lsa Netlify’ning URL o‘zgaruvchisi ishlatiladi)
# SITE_URL=https://dilrabo.uz
